# StackBack Roadmap — environment variables.
# The app works with NO env vars (localStorage). Set both of these to switch to the
# shared Supabase backend. See SUPABASE.md. Copy to .env.local for local dev; add the
# same two to Vercel → Project Settings → Environment Variables for production.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
