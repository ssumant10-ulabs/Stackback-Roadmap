# StackBack Roadmap: environment.
# With no Firebase vars the app runs on browser localStorage, unauthenticated, exactly as it
# did before. Set all six and it switches to the shared Firestore backend behind a login.
# None of these are secrets. Firebase security lives in the Firestore and Storage rules.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated domains allowed to sign in. Blank allows any Google account.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=ulabsglobal.com

# Set to true only after upgrading to Blaze and publishing the Storage rules.
# On Spark, leave this unset: Storage is unavailable and the link route covers screenshots.
NEXT_PUBLIC_FIREBASE_STORAGE_ENABLED=

# --- Help Centre query log (Sanity) ---
# Without these the Help Centre still runs: the FAQ half is generated from the deliverable
# and needs nothing, and the Queries tab renders an explained empty state.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Server-only. Never prefixed NEXT_PUBLIC_: it can rewrite the dataset. Editor token from
# sanity.io/manage > API > Tokens. Only app/api/help/queries reads it.
SANITY_API_WRITE_TOKEN=
